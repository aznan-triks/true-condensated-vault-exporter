{
  "name": "vault-exporter",
  "version": "2.0.1",
  "description": "Modular and customizable Obsidian vault exporter for NotebookLM, HTML, Markdown and split outputs.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "export",
    "notebooklm",
    "html"
  ],
  "author": "aznan-triks",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}