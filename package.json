{
  "name": "vault-exporter",
  "version": "2.1.0",
  "description": "Obsidian desktop plugin for exporting vaults to NotebookLM text, HTML, Markdown, split files, or ZIP bundles.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && node esbuild.config.mjs production && npm run smoke",
    "smoke": "node tools/mock-obsidian/run.cjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "export",
    "notebooklm",
    "html"
  ],
  "author": "aznan-triks",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "obsidian": "1.7.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
